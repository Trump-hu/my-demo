# 服务配置
NODE_ENV=development
PORT=3000

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=demo_server
DB_DIALECT=mysql

# 是否在启动时同步模型到数据库（生产环境请关闭）
DB_SYNC=false

# JWT 配置
JWT_SECRET=please_change_this_to_a_random_long_string
JWT_EXPIRES_IN=7d

# 文件上传配置
# 存储根目录（相对路径基于启动目录），分片临时文件在 tmp/，合并结果在 files/
UPLOAD_DIR=uploads
# 单个文件大小上限(字节)，默认 1GB
UPLOAD_MAX_FILE_SIZE=1073741824
# 单个分片大小上限(字节)，默认 100MB
UPLOAD_MAX_CHUNK_SIZE=104857600
